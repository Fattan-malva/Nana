# Salin file ini menjadi .env lalu isi nilainya.
# Jangan commit .env (sudah masuk .gitignore).

# --- Ollama (chat + web search) ---
OLLAMA_URL=https://ollama.com/v1/chat/completions
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_WEB_TIMEOUT=35

# --- Agent ---
TOOLS_ENABLED=true
TOOLS_MAX_STEPS=10
SLEEP_AFTER_SECONDS=30
WAKE_WORD=NANA
TOOLS_STRICT_VSCODE=false
TOOLS_CMD_TIMEOUT=20
# TOOLS_ALLOWED_COMMANDS=code,notepad,explorer,git,python,py,pip

# --- Browser ---
# Kosong = browser default Windows yang sedang dipakai user (profil/history user).
# Isi hanya kalau user ingin browser tertentu: brave|chrome|edge|firefox|vivaldi|opera
# NANA_BROWSER=brave
# Kontrol memakai UI Automation pada window browser user.

# --- Web realtime ---
WEB_AUTO_SEARCH=true
WEB_CACHE_SECONDS=600
